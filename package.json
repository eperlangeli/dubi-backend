{
  "name": "dubi-backend",
  "version": "1.0.0",
  "description": "DUBI Backend - Node.js + Express + PostgreSQL",
  "main": "server.js",
  "scripts": {
    "prestart": "node init-db.js && node seed-recipes.js",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init-db": "node init-db.js",
    "seed-recipes": "node seed-recipes.js",
    "ingest-usda": "node scripts/ingest-usda-ingredients.js",
    "import-nutrition-csv": "node scripts/import-official-nutrition-csv.js",
    "audit-recipes": "node scripts/audit-recipes-with-sources.js",
    "audit-dubi-recipes": "node scripts/audit-dubi-recipes.js",
    "verify-dubi-engine-cases": "node scripts/verify-dubi-engine-cases.js",
    "export-recipes-pdf-data": "node scripts/export-recipes-pdf-data.js",
    "migrate-canonical-onboarding": "node scripts/migrate-onboarding-canonical-values.js",
    "test": "node --check server.js && node --check seed-recipes.js && node --check services/db-context.js && node --check scripts/ingest-usda-ingredients.js && node --check scripts/import-official-nutrition-csv.js && node --check scripts/audit-recipes-with-sources.js && node --check routes/ask-dubi.js && node --check routes/ai-engine.js && node --check routes/onboarding.js && node --check routes/wearables.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "pg": "^8.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": "18.x"
  }
}
